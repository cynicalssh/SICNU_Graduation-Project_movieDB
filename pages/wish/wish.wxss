@import '../../component/nullTip/nullTip.wxss';

.archive-page {
    min-height: 100vh;
    background: linear-gradient(180deg, #f3f8f5 0%, #edf2ef 100%);
    padding-bottom: 40rpx;
}

.archive-hero {
    padding: 30rpx 30rpx 16rpx;
}

.archive-title {
    font-size: 42rpx;
    color: #1d2b24;
    font-weight: 700;
}

.archive-subtitle {
    margin-top: 10rpx;
    font-size: 24rpx;
    color: #6b7a73;
}

.tab-content-item {
    box-sizing: border-box;
    padding: 16rpx 24rpx 24rpx;
}

.favorite-film-item {
    display: flex;
    margin-bottom: 24rpx;
    border-radius: 22rpx;
    background: #ffffff;
    box-shadow: 0 8rpx 24rpx rgba(39, 63, 50, 0.08);
    padding: 18rpx;
}

.favorite-film-cover {
    width: 188rpx;
    height: 262rpx;
    border-radius: 14rpx;
    box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.17);
    background: #e6ece8;
    flex-shrink: 0;
}

.favorite-film-info {
    flex: 1;
    margin-left: 20rpx;
    min-width: 0;
}

.favorite-film-txt {
    margin-bottom: 12rpx;
    color: #607268;
    font-size: 24rpx;
    line-height: 1.5;
}

.favorite-film-title {
    font-size: 34rpx;
    color: #23372c;
    font-weight: 600;
}

.theme-dark.archive-page {
    background: #0f1216;
}

.theme-dark .archive-title {
    color: #eaf0f6;
}

.theme-dark .archive-subtitle {
    color: #9aa4af;
}

.theme-dark .favorite-film-item {
    background: #171b22;
    box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.26);
}

.theme-dark .favorite-film-cover {
    background: #262d36;
}

.theme-dark .favorite-film-txt {
    color: #a9b3be;
}

.theme-dark .favorite-film-title {
    color: #e8eef6;
}
