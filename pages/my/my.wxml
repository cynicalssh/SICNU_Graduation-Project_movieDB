<view class="container {{darkMode ? 'theme-dark' : ''}}">
    <!-- 顶部用户信息区域 -->
    <view class="user-header" style="{{isSkinGradient ? ('background: ' + skin) : ''}}" bindtap="openBackgroundPreview">
        <image wx:if="{{!isSkinGradient}}" class="user-header-bg-image" src="{{skin}}" mode="aspectFill"></image>
        <!-- 顶部操作栏 -->
        <view class="header-top">
            <view class="header-menu" catchtap="viewMenu">
                <text class="menu-icon">☰</text>
            </view>
            <view class="header-center-spacer"></view>
            <view class="header-actions" catchtap="preventBgPreviewClose">
                <text class="action-icon">🎧</text>
                <text class="action-icon">✉️</text>
            </view>
        </view>
        
        <!-- 用户信息卡片 -->
        <view class="user-card">
            <view class="user-profile-panel">
                <view class="profile-main">
                    <button class="avatar-wrapper avatar-btn" catchtap="onAvatarTap" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" hover-class="none">
                        <image src="{{userInfo.avatarUrl || '/resource/logo.png'}}" class="user-avatar" binderror="onAvatarError"></image>
                        <view class="avatar-camera">
                            <text class="camera-icon">📷</text>
                        </view>
                    </button>

                    <view class="profile-info" catchtap="preventBgPreviewClose">
                        <view class="user-name">
                            {{userInfo.nickName || '微信用户'}}
                            <block wx:if="{{userInfo.gender == 1}}">
                                <view class="user-sex-male"></view>
                            </block>
                            <block wx:elif="{{userInfo.gender == 2}}">
                                <view class="user-sex-female"></view>
                            </block>
                        </view>
                        
                        <view class="user-meta">
                            <view class="user-meta-line">
                                <text class="user-meta-label">小程序ID号：</text>
                                <text class="user-meta-value">{{userId || '-'}}</text>
                            </view>
                            <view class="user-meta-line">
                                <text class="user-meta-label">IP属地：</text>
                                <text class="user-meta-value">{{userInfo.city || '未知'}}</text>
                            </view>
                        </view>

                        <input wx:if="{{!isWechatAuthed}}" class="nickname-input" type="nickname" placeholder="点击输入昵称" bindblur="onNicknameBlur" />
                        <view wx:if="{{!isWechatAuthed}}" class="login-guide-text">点击头像选择微信头像，输入昵称后即完成资料</view>
                        
                        <view class="wechat-login-btn" wx:if="{{!isWechatAuthed}}" catchtap="startWechatLogin">
                            <text>{{isLoggingIn ? '授权中...' : '微信授权登录'}}</text>
                        </view>
                    </view>
                </view>
                <view class="profile-intro-wrap" catchtap="editSignature">
                    <text wx:if="{{userSignature && userSignature.length > 0}}" class="profile-intro-text">{{userSignature}}</text>
                    <text wx:else class="profile-intro-placeholder">点击这里，填写简历</text>
                </view>
            </view>
        </view>
    </view>
    
    <!-- 导航标签栏 -->
    <view class="nav-tabs">
        <view class="tab-item {{currentTab === 'home' ? 'active' : ''}}" bindtap="switchTab" data-tab="home">
            <text>主页</text>
        </view>
        <view class="tab-item {{currentTab === 'album' ? 'active' : ''}}" bindtap="switchTab" data-tab="album">
            <text>相册</text>
        </view>
        <view class="tab-search" bindtap="viewSearch">
            <text>🔍</text>
        </view>
    </view>
    
    <!-- 主页内容 -->
    <block wx:if="{{currentTab === 'home'}}">
        <!-- 创建我的书影音TOP10 -->
        <view class="content-section">
            <view class="top10-card" bindtap="createTop10">
                <view class="top10-icon">📊</view>
                <view class="top10-content">
                    <text class="top10-title">创建我的书影音 TOP10</text>
                    <text class="top10-desc">记录你的最爱</text>
                </view>
                <view class="top10-decoration">💕</view>
            </view>
        </view>

        <!-- 浏览记录 -->
        <view class="content-section">
            <view class="section-header" bindtap="viewHistory">
                <text class="section-title">浏览记录</text>
                <text class="section-desc" wx:if="{{historyCount > 0}}">已记录 {{historyCount}} 部电影</text>
                <text class="section-arrow">›</text>
            </view>

            <block wx:if="{{recentHistoryFilms.length > 0}}">
                <view class="recent-history-list">
                    <block wx:for="{{recentHistoryFilms}}" wx:for-item="historyFilm" wx:key="id">
                        <view class="recent-history-item" bindtap="viewHistoryFilmDetail" data-id="{{historyFilm.id}}">
                            <image class="recent-history-cover" src="{{historyFilm.image || '/resource/logo.png'}}" mode="aspectFill"></image>
                            <view class="recent-history-info">
                                <text class="recent-history-title">{{historyFilm.title}}</text>
                                <view class="recent-history-meta">
                                    <text wx:if="{{historyFilm.year}}">{{historyFilm.year}}</text>
                                    <text wx:if="{{historyFilm.year}}"> · </text>
                                    <block wx:if="{{historyFilm.rating.average > 0}}">
                                        <text>{{historyFilm.rating.average}} 分</text>
                                    </block>
                                    <block wx:else>
                                        <text>暂无评分</text>
                                    </block>
                                </view>
                                <text class="recent-history-time">{{historyFilm.date}} {{historyFilm.time}}</text>
                            </view>
                            <text class="recent-history-arrow">›</text>
                        </view>
                    </block>
                </view>
            </block>
            <block wx:else>
                <view class="history-empty-card" bindtap="goBrowseMovies">
                    <text class="history-empty-icon">🎬</text>
                    <view class="history-empty-info">
                        <text class="history-empty-title">暂无浏览记录</text>
                        <text class="history-empty-desc">去看看正在热映的电影</text>
                    </view>
                    <text class="history-empty-action">去逛逛</text>
                </view>
            </block>
        </view>
        
        <!-- 书影音档案区域 -->
        <view class="content-section">
            <view class="section-header" bindtap="viewArchive">
                <text class="section-title">书影音档案</text>
                <text class="section-arrow">›</text>
            </view>
            
            <!-- 影视 -->
            <view class="archive-subsection">
                <view class="subsection-header" bindtap="viewFilmArchive">
                    <text class="subsection-title">影视</text>
                    <text class="subsection-arrow">›</text>
                </view>
                <view class="archive-items">
                    <view class="archive-item" bindtap="viewWish">
                        <view class="archive-icon">⭐</view>
                        <text class="archive-label">想看</text>
                        <text class="archive-count">{{wishCount}}</text>
                    </view>
                    <view class="archive-item" bindtap="viewWatched">
                        <view class="archive-icon">✓</view>
                        <text class="archive-label">看过</text>
                        <text class="archive-count">{{watchedCount}}</text>
                    </view>
                </view>
            </view>
        </view>
    </block>
    
    <!-- 相册内容 -->
    <block wx:if="{{currentTab === 'album'}}">
        <view class="gallery-section">
            <block wx:if="{{galleryPictures.length === 0}}">
                <view class="empty-tip">
                    <text class="empty-icon">📷</text>
                    <text class="empty-text">还没有照片</text>
                    <text class="empty-desc">点击右上角上传照片</text>
                </view>
            </block>
            <block wx:else>
                <view class="gallery-grid">
                    <block wx:for="{{galleryPictures}}" wx:for-item="picture" wx:for-index="index" wx:key="index">
                        <view class="gallery-item" bindtap="previewGalleryImage" data-index="{{index}}">
                            <image class="gallery-image" src="{{picture}}" mode="aspectFill"></image>
                        </view>
                    </block>
                </view>
            </block>
        </view>
    </block>

    <!-- 背景预览 -->
    <view wx:if="{{backgroundPreviewVisible}}" class="bg-preview-overlay" bindtap="closeBackgroundPreview" catchtouchmove="preventBgPreviewClose">
        <view class="bg-preview-topbar" catchtap="preventBgPreviewClose">
            <view class="bg-preview-close" catchtap="closeBackgroundPreview">✕</view>
            <view class="bg-preview-change-top {{isChoosingBackground ? 'disabled' : ''}}" catchtap="chooseBackgroundImage">
                <text>{{isChoosingBackground ? '更换中...' : '更换背景'}}</text>
            </view>
        </view>
        <view class="bg-preview-stage" catchtap="preventBgPreviewClose">
            <image wx:if="{{!isSkinGradient}}" class="bg-preview-image" src="{{skin}}" mode="aspectFit"></image>
            <view wx:else class="bg-preview-gradient" style="background: {{skin}}"></view>
        </view>
        <view class="bg-preview-action {{isChoosingBackground ? 'disabled' : ''}}" catchtap="chooseBackgroundImage">
            <text class="bg-preview-action-text">{{isChoosingBackground ? '更换中...' : '更换背景图'}}</text>
            <text class="bg-preview-action-icon">🖼️</text>
        </view>
    </view>

    <!-- 左侧抽屉遮罩 -->
    <view class="drawer-mask {{drawerVisible ? 'drawer-mask-show' : ''}}" bindtap="closeDrawer"></view>

    <!-- 左侧抽屉 -->
    <view class="side-drawer {{drawerVisible ? 'side-drawer-open' : ''}}" catchtap="preventDrawerClose">
        <view class="drawer-header">
            <text class="drawer-close" bindtap="closeDrawer">✕</text>
            <view class="drawer-profile">
                <image class="drawer-avatar" src="{{userInfo.avatarUrl || '/resource/logo.png'}}" binderror="onAvatarError"></image>
                <view class="drawer-profile-info">
                    <text class="drawer-name">{{userInfo.nickName || '微信用户'}}</text>
                    <text class="drawer-subtitle">ID: {{userId || '-'}}<block wx:if="{{userInfo.city}}"> · {{userInfo.city}}</block></text>
                </view>
            </view>
        </view>

        <scroll-view class="drawer-content" scroll-y="true">
            <view class="drawer-section-title">个人中心</view>
            <view class="drawer-item" data-action="editProfile" bindtap="handleDrawerAction">
                <text class="drawer-item-icon">👤</text>
                <text class="drawer-item-label">个人资料</text>
                <text class="drawer-item-arrow">›</text>
            </view>
            <view class="drawer-item" data-action="editNickname" bindtap="handleDrawerAction">
                <text class="drawer-item-icon">✏️</text>
                <text class="drawer-item-label">修改昵称</text>
                <text class="drawer-item-arrow">›</text>
            </view>
            <view class="drawer-item" data-action="editSignature" bindtap="handleDrawerAction">
                <text class="drawer-item-icon">📝</text>
                <text class="drawer-item-label">修改签名</text>
                <text class="drawer-item-arrow">›</text>
            </view>

            <view class="drawer-section-title">电影数据</view>
            <view class="drawer-item" data-action="history" bindtap="handleDrawerAction">
                <text class="drawer-item-icon">🕘</text>
                <text class="drawer-item-label">浏览历史</text>
                <text class="drawer-item-arrow">›</text>
            </view>
            <view class="drawer-item" data-action="wish" bindtap="handleDrawerAction">
                <text class="drawer-item-icon">⭐</text>
                <text class="drawer-item-label">想看清单（{{wishCount}}）</text>
                <text class="drawer-item-arrow">›</text>
            </view>
            <view class="drawer-item" data-action="watched" bindtap="handleDrawerAction">
                <text class="drawer-item-icon">✓</text>
                <text class="drawer-item-label">看过清单（{{watchedCount}}）</text>
                <text class="drawer-item-arrow">›</text>
            </view>

            <view class="drawer-section-title">设置</view>
            <view class="drawer-item drawer-switch-item">
                <text class="drawer-item-icon">🌙</text>
                <text class="drawer-item-label">暗黑模式</text>
                <switch color="#42bd56" checked="{{darkMode}}" bindchange="onDarkModeSwitch" />
            </view>
            <view class="drawer-item" data-action="setting" bindtap="handleDrawerAction">
                <text class="drawer-item-icon">⚙️</text>
                <text class="drawer-item-label">系统设置</text>
                <text class="drawer-item-arrow">›</text>
            </view>
            <view class="drawer-item" data-action="feedback" bindtap="handleDrawerAction">
                <text class="drawer-item-icon">💬</text>
                <text class="drawer-item-label">帮助与反馈</text>
                <text class="drawer-item-arrow">›</text>
            </view>
            <view class="drawer-item" data-action="about" bindtap="handleDrawerAction">
                <text class="drawer-item-icon">ℹ️</text>
                <text class="drawer-item-label">关于我</text>
                <text class="drawer-item-arrow">›</text>
            </view>

            <view class="drawer-tools">
                <view class="drawer-tool-item" data-action="orders" bindtap="handleDrawerAction">
                    <text class="drawer-tool-icon">🧾</text>
                    <text class="drawer-tool-label">订单</text>
                </view>
                <view class="drawer-tool-item" data-action="cart" bindtap="handleDrawerAction">
                    <text class="drawer-tool-icon">🛒</text>
                    <text class="drawer-tool-label">购物车</text>
                </view>
                <view class="drawer-tool-item" data-action="wallet" bindtap="handleDrawerAction">
                    <text class="drawer-tool-icon">👛</text>
                    <text class="drawer-tool-label">钱包</text>
                </view>
            </view>
        </scroll-view>
    </view>
</view>
