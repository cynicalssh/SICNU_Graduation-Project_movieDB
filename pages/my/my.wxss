/* 容器 */
.container {
    background-color: #f5f5f5;
    min-height: 100vh;
    padding-bottom: 100rpx;
}

/* 顶部用户信息区域 */
.user-header {
    box-sizing: border-box;
    width: 100%;
    background-color: #2c2c2c;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    position: relative;
    padding-bottom: 40rpx;
}

/* 顶部操作栏 */
.header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20rpx 30rpx;
    padding-top: calc(20rpx + env(safe-area-inset-top));
}

.header-menu {
    width: 60rpx;
    height: 60rpx;
    display: flex;
    align-items: center;
    justify-content: center;
}

.menu-icon {
    font-size: 40rpx;
    color: #fff;
    opacity: 0.9;
}

.header-title {
    font-size: 36rpx;
    font-weight: 600;
    color: #fff;
}

.header-actions {
    display: flex;
    gap: 20rpx;
}

.action-icon {
    font-size: 40rpx;
    color: #fff;
    opacity: 0.9;
}

/* 用户信息卡片 */
.user-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 40rpx 30rpx;
}

.avatar-wrapper {
    position: relative;
    margin-bottom: 30rpx;
}

.avatar-btn {
    padding: 0;
    border: none;
    background: transparent;
    line-height: 1;
}

.avatar-btn::after {
    border: none;
}

.user-avatar {
    width: 180rpx;
    height: 180rpx;
    border-radius: 50%;
    border: 4rpx solid rgba(255, 255, 255, 0.3);
    box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

.avatar-camera {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 56rpx;
    height: 56rpx;
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2rpx solid #fff;
}

.camera-icon {
    font-size: 28rpx;
}

.user-name {
    color: #fff;
    font-size: 44rpx;
    font-weight: 600;
    margin-bottom: 16rpx;
    display: flex;
    align-items: center;
    gap: 12rpx;
}

.nickname-input {
    width: 340rpx;
    height: 64rpx;
    line-height: 64rpx;
    border-radius: 32rpx;
    background: rgba(255, 255, 255, 0.18);
    color: #fff;
    font-size: 26rpx;
    text-align: center;
    margin-bottom: 14rpx;
}

.login-guide-text {
    font-size: 22rpx;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 14rpx;
}

.user-sex-male, .user-sex-female {
    display: inline-block;
    width: 32rpx;
    height: 32rpx;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
}

.user-sex-male {
    background-image: url(data:image/png;base64,);
}

.user-sex-female {
    background-image: url(data:image/png;base64,);
}

.user-id-location {
    font-size: 26rpx;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 24rpx;
}

.location-separator {
    margin: 0 8rpx;
}

.wechat-login-btn {
    margin-bottom: 20rpx;
    padding: 12rpx 32rpx;
    border-radius: 999rpx;
    border: 2rpx solid rgba(255, 255, 255, 0.8);
    color: #fff;
    font-size: 26rpx;
    background: rgba(255, 255, 255, 0.15);
}

/* 个人签名 */
.user-signature-wrapper {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20rpx 0;
    border-top: 1rpx solid rgba(255, 255, 255, 0.2);
    border-bottom: 1rpx solid rgba(255, 255, 255, 0.2);
    margin-bottom: 20rpx;
}

.signature-content {
    flex: 1;
    display: flex;
    align-items: center;
}

.signature-text {
    color: #fff;
    font-size: 28rpx;
    line-height: 1.5;
}

.signature-placeholder {
    color: rgba(255, 255, 255, 0.6);
    font-size: 28rpx;
}

.signature-arrow {
    color: rgba(255, 255, 255, 0.6);
    font-size: 36rpx;
    margin-left: 20rpx;
}

/* 关于我 */
.user-about {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16rpx 0;
    margin-bottom: 20rpx;
}

.about-text {
    color: rgba(255, 255, 255, 0.9);
    font-size: 28rpx;
}

.about-arrow {
    color: rgba(255, 255, 255, 0.6);
    font-size: 36rpx;
}

/* 用户统计 */
.user-stats {
    width: 100%;
    display: flex;
    gap: 40rpx;
}

.stats-item {
    color: rgba(255, 255, 255, 0.8);
    font-size: 26rpx;
}

/* 导航标签栏 */
.nav-tabs {
    display: flex;
    align-items: center;
    background-color: #fff;
    padding: 0 30rpx;
    border-bottom: 1rpx solid #e5e5e5;
}

.tab-item {
    flex: 1;
    text-align: center;
    padding: 24rpx 0;
    font-size: 28rpx;
    color: #666;
    position: relative;
}

.tab-item.active {
    color: #42bd56;
    font-weight: 600;
}

.tab-item.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60rpx;
    height: 4rpx;
    background-color: #42bd56;
    border-radius: 2rpx;
}

.tab-search {
    width: 60rpx;
    text-align: center;
    font-size: 32rpx;
    color: #666;
}

/* 内容区域 */
.content-section {
    background-color: #fff;
    margin-top: 20rpx;
    padding: 30rpx;
}

.section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 30rpx;
}

.section-title {
    font-size: 32rpx;
    font-weight: 600;
    color: #333;
}

.section-desc {
    flex: 1;
    font-size: 26rpx;
    color: #999;
    margin-left: 20rpx;
}

.section-arrow {
    font-size: 36rpx;
    color: #999;
}

/* TOP10卡片 */
.top10-card {
    display: flex;
    align-items: center;
    padding: 30rpx;
    background: linear-gradient(135deg, #f5f5f5 0%, #fff 100%);
    border-radius: 16rpx;
    margin-bottom: 20rpx;
}

.top10-icon {
    font-size: 60rpx;
    margin-right: 24rpx;
}

.top10-content {
    flex: 1;
    display: flex;
    flex-direction: column;
}

.top10-title {
    font-size: 30rpx;
    font-weight: 600;
    color: #333;
    margin-bottom: 8rpx;
}

.top10-desc {
    font-size: 24rpx;
    color: #999;
}

.top10-decoration {
    font-size: 48rpx;
}

/* 浏览记录 */
.recent-history-list {
    display: flex;
    flex-direction: column;
    gap: 20rpx;
}

.recent-history-item {
    display: flex;
    align-items: center;
    padding: 20rpx;
    background: linear-gradient(135deg, #f8f8f8 0%, #ffffff 100%);
    border-radius: 14rpx;
}

.recent-history-cover {
    width: 90rpx;
    height: 126rpx;
    border-radius: 10rpx;
    background-color: #ececec;
    flex-shrink: 0;
}

.recent-history-info {
    flex: 1;
    margin-left: 18rpx;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.recent-history-title {
    font-size: 28rpx;
    font-weight: 600;
    color: #333;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.recent-history-meta {
    margin-top: 8rpx;
    font-size: 24rpx;
    color: #666;
}

.recent-history-time {
    margin-top: 10rpx;
    font-size: 22rpx;
    color: #999;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.recent-history-arrow {
    font-size: 34rpx;
    color: #bbb;
    margin-left: 12rpx;
}

.history-empty-card {
    display: flex;
    align-items: center;
    padding: 24rpx;
    border-radius: 14rpx;
    background: #f7f7f7;
}

.history-empty-icon {
    font-size: 46rpx;
    margin-right: 18rpx;
}

.history-empty-info {
    flex: 1;
    display: flex;
    flex-direction: column;
}

.history-empty-title {
    font-size: 28rpx;
    color: #444;
    font-weight: 500;
}

.history-empty-desc {
    font-size: 24rpx;
    color: #999;
    margin-top: 6rpx;
}

.history-empty-action {
    font-size: 24rpx;
    color: #42bd56;
    margin-left: 12rpx;
}

/* 书影音档案 */
.archive-subsection {
    margin-bottom: 40rpx;
}

.subsection-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20rpx;
}

.subsection-title {
    font-size: 30rpx;
    font-weight: 600;
    color: #333;
}

.subsection-arrow {
    font-size: 32rpx;
    color: #999;
}

.archive-items {
    display: flex;
    gap: 30rpx;
    padding: 20rpx 0;
}

.archive-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12rpx;
}

.archive-icon {
    font-size: 48rpx;
    margin-bottom: 8rpx;
}

.archive-label {
    font-size: 26rpx;
    color: #666;
}

.archive-count {
    font-size: 32rpx;
    font-weight: 600;
    color: #333;
}

/* 音乐占位 */
.music-placeholder {
    display: flex;
    align-items: center;
    padding: 30rpx;
    background-color: #f9f9f9;
    border-radius: 12rpx;
}

.music-icon {
    font-size: 40rpx;
    margin-right: 16rpx;
}

.music-text {
    font-size: 26rpx;
    color: #999;
}

/* 空状态提示 */
.empty-tip {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 100rpx 0;
    min-height: 400rpx;
}

.empty-icon {
    font-size: 120rpx;
    margin-bottom: 30rpx;
    opacity: 0.5;
}

.empty-text {
    font-size: 32rpx;
    color: #666;
    margin-bottom: 16rpx;
}

.empty-desc {
    font-size: 26rpx;
    color: #999;
}

/* 相册区域 */
.gallery-section {
    background-color: #fff;
    margin-top: 20rpx;
    padding: 30rpx;
    min-height: calc(100vh - 600rpx);
}

.gallery-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 20rpx;
    margin-bottom: 100rpx;
}

.gallery-item {
    width: calc(33.333% - 14rpx);
    aspect-ratio: 1;
    border-radius: 12rpx;
    overflow: hidden;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
    background-color: #f5f5f5;
}

.gallery-image {
    width: 100%;
    height: 100%;
    display: block;
}

/* 左侧抽屉 */
.drawer-mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.45);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
    z-index: 2000;
}

.drawer-mask-show {
    opacity: 1;
    pointer-events: auto;
}

.side-drawer {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 82%;
    max-width: 620rpx;
    background: #f7f7f7;
    border-top-right-radius: 28rpx;
    border-bottom-right-radius: 28rpx;
    transform: translateX(-105%);
    transition: transform 0.24s ease;
    z-index: 2001;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.18);
}

.side-drawer-open {
    transform: translateX(0);
}

.drawer-header {
    padding: calc(20rpx + env(safe-area-inset-top)) 28rpx 20rpx;
    border-bottom: 1rpx solid #e9e9e9;
}

.drawer-close {
    display: inline-block;
    font-size: 46rpx;
    color: #222;
    margin-bottom: 18rpx;
}

.drawer-profile {
    display: flex;
    align-items: center;
}

.drawer-avatar {
    width: 88rpx;
    height: 88rpx;
    border-radius: 50%;
    background: #ddd;
    flex-shrink: 0;
}

.drawer-profile-info {
    margin-left: 20rpx;
    display: flex;
    flex-direction: column;
}

.drawer-name {
    font-size: 44rpx;
    color: #1f1f1f;
    font-weight: 600;
}

.drawer-subtitle {
    margin-top: 8rpx;
    font-size: 24rpx;
    color: #888;
}

.drawer-content {
    flex: 1;
    padding: 12rpx 18rpx 24rpx;
}

.drawer-section-title {
    padding: 20rpx 12rpx 10rpx;
    color: #8d8d8d;
    font-size: 24rpx;
}

.drawer-item {
    display: flex;
    align-items: center;
    min-height: 86rpx;
    padding: 0 10rpx;
    border-radius: 14rpx;
}

.drawer-item:active {
    background: #ececec;
}

.drawer-item-icon {
    width: 48rpx;
    font-size: 30rpx;
}

.drawer-item-label {
    flex: 1;
    margin-left: 8rpx;
    font-size: 34rpx;
    color: #1f1f1f;
}

.drawer-item-arrow {
    color: #9a9a9a;
    font-size: 34rpx;
}

.drawer-switch-item {
    justify-content: space-between;
    padding-right: 0;
}

.drawer-tools {
    margin-top: 24rpx;
    padding: 18rpx;
    border-radius: 16rpx;
    background: #efefef;
    display: flex;
    justify-content: space-between;
}

.drawer-tool-item {
    width: 31%;
    min-height: 110rpx;
    border-radius: 12rpx;
    background: #f8f8f8;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.drawer-tool-item:active {
    opacity: 0.75;
}

.drawer-tool-icon {
    font-size: 34rpx;
    line-height: 1;
}

.drawer-tool-label {
    margin-top: 10rpx;
    font-size: 24rpx;
    color: #555;
}

/* 暗黑模式 */
.theme-dark.container {
    background-color: #101215;
}

.theme-dark .nav-tabs,
.theme-dark .content-section,
.theme-dark .gallery-section {
    background-color: #171a1f;
}

.theme-dark .tab-item,
.theme-dark .tab-search {
    color: #a8afb8;
}

.theme-dark .tab-item.active {
    color: #63d17f;
}

.theme-dark .section-title,
.theme-dark .subsection-title,
.theme-dark .top10-title,
.theme-dark .recent-history-title,
.theme-dark .archive-count,
.theme-dark .empty-text {
    color: #e9edf2;
}

.theme-dark .section-desc,
.theme-dark .section-arrow,
.theme-dark .top10-desc,
.theme-dark .recent-history-time,
.theme-dark .recent-history-meta,
.theme-dark .archive-label,
.theme-dark .empty-desc {
    color: #9aa2ad;
}

.theme-dark .top10-card,
.theme-dark .recent-history-item,
.theme-dark .history-empty-card,
.theme-dark .music-placeholder {
    background: #20242b;
}

.theme-dark .history-empty-title {
    color: #d6dce4;
}

.theme-dark .recent-history-cover,
.theme-dark .gallery-item {
    background-color: #262b33;
}

.theme-dark .section-header,
.theme-dark .subsection-header {
    border-color: #252a31;
}

.theme-dark .side-drawer {
    background: #16191f;
}

.theme-dark .drawer-header {
    border-bottom-color: #2a3038;
}

.theme-dark .drawer-close,
.theme-dark .drawer-name,
.theme-dark .drawer-item-label {
    color: #eef3f7;
}

.theme-dark .drawer-subtitle,
.theme-dark .drawer-section-title,
.theme-dark .drawer-item-arrow {
    color: #9aa3ad;
}

.theme-dark .drawer-item:active {
    background: #232933;
}

.theme-dark .drawer-tools {
    background: #1f242c;
}

.theme-dark .drawer-tool-item {
    background: #252b34;
}

.theme-dark .drawer-tool-label {
    color: #b8c0ca;
}
