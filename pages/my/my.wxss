/* 容器 */
.container {
    background-color: #f5f5f5;
    min-height: 100vh;
    padding-bottom: 100rpx;
    position: relative;
}

/* 顶部用户信息区域 */
.user-header {
    box-sizing: border-box;
    width: 100%;
    background: linear-gradient(145deg, #4fb379 0%, #3f9c66 55%, #2f8555 100%);
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    position: relative;
    overflow: hidden;
    min-height: 760rpx;
    padding-bottom: 220rpx;
}

.user-header-bg-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
}

.user-header::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(8, 12, 22, 0.3) 0%, rgba(14, 18, 30, 0.42) 38%, rgba(24, 22, 28, 0.5) 74%, rgba(245, 245, 245, 0.1) 100%);
    -webkit-backdrop-filter: blur(8rpx) saturate(130%);
    backdrop-filter: blur(8rpx) saturate(130%);
    pointer-events: none;
}

.user-header::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2rpx;
    height: 340rpx;
    background:
        radial-gradient(circle at 22% -40%, rgba(255, 255, 255, 0.26), transparent 58%),
        linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgba(245, 245, 245, 0.68) 70%, #f5f5f5 100%);
    pointer-events: none;
}

/* 顶部操作栏 */
.header-top {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 26rpx 30rpx;
    padding-top: calc(28rpx + env(safe-area-inset-top));
}

.header-menu {
    width: 64rpx;
    height: 64rpx;
    display: flex;
    align-items: center;
    justify-content: center;
}

.menu-icon {
    font-size: 50rpx;
    color: #fff;
    opacity: 0.9;
    text-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.35);
}

.header-center-spacer {
    flex: 1;
}

.header-actions {
    display: flex;
    justify-content: flex-end;
    gap: 16rpx;
    min-width: 150rpx;
}

.action-icon {
    width: 64rpx;
    height: 64rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 38rpx;
    color: #fff;
    opacity: 0.9;
    text-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.35);
}

/* 用户信息卡片 */
.user-card {
    position: relative;
    z-index: 2;
    padding: 42rpx 36rpx 0;
}

.user-profile-panel {
    position: relative;
    border-radius: 24rpx;
    padding: 20rpx 12rpx;
    background: transparent;
    border: none;
    box-shadow: none;
    overflow: hidden;
}

.user-profile-panel::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 24rpx;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0.03) 100%);
    -webkit-backdrop-filter: blur(14rpx) saturate(120%);
    backdrop-filter: blur(14rpx) saturate(120%);
    pointer-events: none;
}

.profile-main {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    min-height: 208rpx;
}

.profile-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}

.avatar-wrapper {
    position: relative;
    margin: 0 24rpx 0 0;
    width: 180rpx;
    height: 180rpx;
    border-radius: 50%;
}

.avatar-btn {
    width: 180rpx;
    height: 180rpx;
    min-height: 180rpx;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: transparent !important;
    line-height: 0;
    overflow: visible;
}

.avatar-btn::after {
    border: none !important;
}

.user-avatar {
    width: 180rpx;
    height: 180rpx;
    border-radius: 50%;
    border: 4rpx solid rgba(255, 255, 255, 0.45);
    box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.26);
}

.avatar-camera {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 56rpx;
    height: 56rpx;
    background-color: rgba(0, 0, 0, 0.45);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2rpx solid rgba(255, 255, 255, 0.75);
}

.camera-icon {
    font-size: 28rpx;
}

.user-name {
    color: #fff;
    font-size: 56rpx;
    font-weight: 600;
    margin-bottom: 10rpx;
    display: flex;
    align-items: center;
    gap: 12rpx;
    line-height: 1.1;
    text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.36);
}

.nickname-input {
    width: 360rpx;
    max-width: 100%;
    height: 64rpx;
    line-height: 64rpx;
    border-radius: 32rpx;
    background: rgba(255, 255, 255, 0.18);
    color: #fff;
    font-size: 26rpx;
    text-align: center;
    margin-bottom: 14rpx;
}

.login-guide-text {
    font-size: 22rpx;
    color: rgba(255, 255, 255, 0.82);
    margin-bottom: 12rpx;
}

.user-sex-male, .user-sex-female {
    display: inline-block;
    width: 32rpx;
    height: 32rpx;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
}

.user-sex-male {
    background-image: url(data:image/png;base64,);
}

.user-sex-female {
    background-image: url(data:image/png;base64,);
}

.user-meta {
    display: flex;
    flex-direction: column;
    gap: 4rpx;
    margin-bottom: 6rpx;
}

.user-meta-line {
    display: flex;
    align-items: center;
    font-size: 21rpx;
    line-height: 1.4;
}

.user-meta-label {
    color: rgba(255, 255, 255, 0.62);
}

.user-meta-value {
    color: rgba(255, 255, 255, 0.82);
}

.profile-intro-wrap {
    position: relative;
    z-index: 1;
    margin-top: 10rpx;
    padding: 2rpx 6rpx;
    display: flex;
    align-items: flex-start;
    min-height: 36rpx;
}

.profile-intro-text,
.profile-intro-placeholder {
    font-size: 25rpx;
    line-height: 1.45;
    max-width: 640rpx;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    letter-spacing: 0.8rpx;
    font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", sans-serif;
}

.profile-intro-text {
    color: rgba(255, 255, 255, 0.85);
    font-weight: 500;
    text-shadow: 0 3rpx 10rpx rgba(0, 0, 0, 0.24);
}

.profile-intro-placeholder {
    color: rgba(255, 255, 255, 0.58);
    font-weight: 400;
}

.wechat-login-btn {
    margin-top: 8rpx;
    padding: 12rpx 30rpx;
    border-radius: 999rpx;
    border: 2rpx solid rgba(255, 255, 255, 0.72);
    color: #ffffff;
    font-size: 24rpx;
    font-weight: 500;
    background: rgba(0, 0, 0, 0.18);
}

/* 导航标签栏 */
.nav-tabs {
    display: flex;
    align-items: center;
    margin: -126rpx 24rpx 0;
    padding: 0 28rpx;
    background: rgba(255, 255, 255, 0.2);
    border: 1rpx solid rgba(255, 255, 255, 0.28);
    border-radius: 22rpx;
    -webkit-backdrop-filter: blur(16rpx) saturate(125%);
    backdrop-filter: blur(16rpx) saturate(125%);
    position: relative;
    z-index: 5;
}

.tab-item {
    flex: 1;
    text-align: center;
    padding: 24rpx 0;
    font-size: 28rpx;
    color: rgba(255, 255, 255, 0.82);
    position: relative;
}

.tab-item.active {
    color: #fff;
    font-weight: 600;
}

.tab-item.active::after {
    content: '';
    position: absolute;
    bottom: 4rpx;
    left: 50%;
    transform: translateX(-50%);
    width: 60rpx;
    height: 4rpx;
    background-color: rgba(255, 255, 255, 0.95);
    border-radius: 2rpx;
}

.tab-search {
    width: 60rpx;
    text-align: center;
    font-size: 32rpx;
    color: rgba(255, 255, 255, 0.9);
}

/* 内容区域 */
.content-section {
    background-color: #fff;
    margin-top: 18rpx;
    padding: 30rpx;
    border-radius: 20rpx;
    margin-left: 16rpx;
    margin-right: 16rpx;
}

.section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 30rpx;
}

.section-title {
    font-size: 32rpx;
    font-weight: 600;
    color: #333;
}

.section-desc {
    flex: 1;
    font-size: 26rpx;
    color: #999;
    margin-left: 20rpx;
}

.section-arrow {
    font-size: 36rpx;
    color: #999;
}

/* TOP10卡片 */
.top10-card {
    display: flex;
    align-items: center;
    padding: 30rpx;
    background: linear-gradient(135deg, #f5f5f5 0%, #fff 100%);
    border-radius: 16rpx;
    margin-bottom: 20rpx;
}

.top10-icon {
    font-size: 60rpx;
    margin-right: 24rpx;
}

.top10-content {
    flex: 1;
    display: flex;
    flex-direction: column;
}

.top10-title {
    font-size: 30rpx;
    font-weight: 600;
    color: #333;
    margin-bottom: 8rpx;
}

.top10-desc {
    font-size: 24rpx;
    color: #999;
}

.top10-decoration {
    font-size: 48rpx;
}

/* 浏览记录 */
.recent-history-list {
    display: flex;
    flex-direction: column;
    gap: 20rpx;
}

.recent-history-item {
    display: flex;
    align-items: center;
    padding: 20rpx;
    background: linear-gradient(135deg, #f8f8f8 0%, #ffffff 100%);
    border-radius: 14rpx;
}

.recent-history-cover {
    width: 90rpx;
    height: 126rpx;
    border-radius: 10rpx;
    background-color: #ececec;
    flex-shrink: 0;
}

.recent-history-info {
    flex: 1;
    margin-left: 18rpx;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.recent-history-title {
    font-size: 28rpx;
    font-weight: 600;
    color: #333;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.recent-history-meta {
    margin-top: 8rpx;
    font-size: 24rpx;
    color: #666;
}

.recent-history-time {
    margin-top: 10rpx;
    font-size: 22rpx;
    color: #999;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.recent-history-arrow {
    font-size: 34rpx;
    color: #bbb;
    margin-left: 12rpx;
}

.history-empty-card {
    display: flex;
    align-items: center;
    padding: 24rpx;
    border-radius: 14rpx;
    background: #f7f7f7;
}

.history-empty-icon {
    font-size: 46rpx;
    margin-right: 18rpx;
}

.history-empty-info {
    flex: 1;
    display: flex;
    flex-direction: column;
}

.history-empty-title {
    font-size: 28rpx;
    color: #444;
    font-weight: 500;
}

.history-empty-desc {
    font-size: 24rpx;
    color: #999;
    margin-top: 6rpx;
}

.history-empty-action {
    font-size: 24rpx;
    color: #42bd56;
    margin-left: 12rpx;
}

/* 书影音档案 */
.archive-subsection {
    margin-bottom: 40rpx;
}

.subsection-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20rpx;
}

.subsection-title {
    font-size: 30rpx;
    font-weight: 600;
    color: #333;
}

.subsection-arrow {
    font-size: 32rpx;
    color: #999;
}

.archive-items {
    display: flex;
    gap: 30rpx;
    padding: 20rpx 0;
}

.archive-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12rpx;
}

.archive-icon {
    font-size: 48rpx;
    margin-bottom: 8rpx;
}

.archive-label {
    font-size: 26rpx;
    color: #666;
}

.archive-count {
    font-size: 32rpx;
    font-weight: 600;
    color: #333;
}

/* 音乐占位 */
.music-placeholder {
    display: flex;
    align-items: center;
    padding: 30rpx;
    background-color: #f9f9f9;
    border-radius: 12rpx;
}

.music-icon {
    font-size: 40rpx;
    margin-right: 16rpx;
}

.music-text {
    font-size: 26rpx;
    color: #999;
}

/* 空状态提示 */
.empty-tip {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 100rpx 0;
    min-height: 400rpx;
}

.empty-icon {
    font-size: 120rpx;
    margin-bottom: 30rpx;
    opacity: 0.5;
}

.empty-text {
    font-size: 32rpx;
    color: #666;
    margin-bottom: 16rpx;
}

.empty-desc {
    font-size: 26rpx;
    color: #999;
}

/* 相册区域 */
.gallery-section {
    background-color: #fff;
    margin-top: 20rpx;
    padding: 30rpx;
    min-height: calc(100vh - 600rpx);
}

.gallery-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 20rpx;
    margin-bottom: 100rpx;
}

.gallery-item {
    width: calc(33.333% - 14rpx);
    aspect-ratio: 1;
    border-radius: 12rpx;
    overflow: hidden;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
    background-color: #f5f5f5;
}

.gallery-image {
    width: 100%;
    height: 100%;
    display: block;
}

/* 背景预览 */
.bg-preview-overlay {
    position: fixed;
    inset: 0;
    z-index: 3200;
    background: rgba(0, 0, 0, 0.96);
    display: flex;
    flex-direction: column;
    padding: calc(24rpx + env(safe-area-inset-top)) 32rpx 0;
}

.bg-preview-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    z-index: 2;
}

.bg-preview-close {
    width: 72rpx;
    height: 72rpx;
    border-radius: 50%;
    color: #fff;
    font-size: 62rpx;
    line-height: 64rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.08);
}

.bg-preview-change-top {
    height: 72rpx;
    padding: 0 28rpx;
    border-radius: 36rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 28rpx;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.16);
}

.bg-preview-stage {
    flex: 1;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20rpx 0 170rpx;
}

.bg-preview-image {
    width: 100%;
    max-height: 100%;
    border-radius: 20rpx;
    background: rgba(255, 255, 255, 0.05);
}

.bg-preview-gradient {
    width: 100%;
    height: 68vh;
    border-radius: 20rpx;
    box-shadow: 0 30rpx 60rpx rgba(0, 0, 0, 0.45);
}

.bg-preview-action {
    position: fixed;
    left: 32rpx;
    right: 32rpx;
    bottom: calc(34rpx + env(safe-area-inset-bottom));
    min-height: 94rpx;
    border-radius: 26rpx;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 34rpx;
    color: #fff;
    background: rgba(255, 255, 255, 0.12);
    -webkit-backdrop-filter: blur(14rpx);
    backdrop-filter: blur(14rpx);
}

.bg-preview-change-top.disabled,
.bg-preview-action.disabled {
    opacity: 0.65;
}

.bg-preview-action-text {
    font-size: 42rpx;
    font-weight: 600;
}

.bg-preview-action-icon {
    font-size: 40rpx;
}

/* 左侧抽屉 */
.drawer-mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.45);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
    z-index: 2000;
}

.drawer-mask-show {
    opacity: 1;
    pointer-events: auto;
}

.side-drawer {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 82%;
    max-width: 620rpx;
    background: #f7f7f7;
    border-top-right-radius: 28rpx;
    border-bottom-right-radius: 28rpx;
    transform: translateX(-105%);
    transition: transform 0.24s ease;
    z-index: 2001;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.18);
}

.side-drawer-open {
    transform: translateX(0);
}

.drawer-header {
    padding: calc(20rpx + env(safe-area-inset-top)) 28rpx 20rpx;
    border-bottom: 1rpx solid #e9e9e9;
}

.drawer-close {
    display: inline-block;
    font-size: 46rpx;
    color: #222;
    margin-bottom: 18rpx;
}

.drawer-profile {
    display: flex;
    align-items: center;
}

.drawer-avatar {
    width: 88rpx;
    height: 88rpx;
    border-radius: 50%;
    background: #ddd;
    flex-shrink: 0;
}

.drawer-profile-info {
    margin-left: 20rpx;
    display: flex;
    flex-direction: column;
}

.drawer-name {
    font-size: 44rpx;
    color: #1f1f1f;
    font-weight: 600;
}

.drawer-subtitle {
    margin-top: 8rpx;
    font-size: 24rpx;
    color: #888;
}

.drawer-content {
    flex: 1;
    padding: 12rpx 18rpx 24rpx;
}

.drawer-section-title {
    padding: 20rpx 12rpx 10rpx;
    color: #8d8d8d;
    font-size: 24rpx;
}

.drawer-item {
    display: flex;
    align-items: center;
    min-height: 86rpx;
    padding: 0 10rpx;
    border-radius: 14rpx;
}

.drawer-item:active {
    background: #ececec;
}

.drawer-item-icon {
    width: 48rpx;
    font-size: 30rpx;
}

.drawer-item-label {
    flex: 1;
    margin-left: 8rpx;
    font-size: 34rpx;
    color: #1f1f1f;
}

.drawer-item-arrow {
    color: #9a9a9a;
    font-size: 34rpx;
}

.drawer-switch-item {
    justify-content: space-between;
    padding-right: 0;
}

.drawer-tools {
    margin-top: 24rpx;
    padding: 18rpx;
    border-radius: 16rpx;
    background: #efefef;
    display: flex;
    justify-content: space-between;
}

.drawer-tool-item {
    width: 31%;
    min-height: 110rpx;
    border-radius: 12rpx;
    background: #f8f8f8;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.drawer-tool-item:active {
    opacity: 0.75;
}

.drawer-tool-icon {
    font-size: 34rpx;
    line-height: 1;
}

.drawer-tool-label {
    margin-top: 10rpx;
    font-size: 24rpx;
    color: #555;
}

/* 暗黑模式 */
.theme-dark.container {
    background-color: #101215;
}

.theme-dark .user-header {
    background: linear-gradient(145deg, #161b22 0%, #141820 100%);
}

.theme-dark .user-header::before {
    background: linear-gradient(180deg, rgba(5, 7, 12, 0.4) 0%, rgba(9, 13, 20, 0.56) 45%, rgba(11, 15, 23, 0.72) 100%);
}

.theme-dark .user-header::after {
    background:
        radial-gradient(circle at 22% -40%, rgba(255, 255, 255, 0.12), transparent 58%),
        linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgba(16, 18, 24, 0.76) 72%, #101215 100%);
}

.theme-dark .header-menu,
.theme-dark .action-icon {
    background: transparent;
    border-color: transparent;
}

.theme-dark .user-profile-panel {
    background: transparent;
    border: none;
    box-shadow: none;
}

.theme-dark .user-profile-panel::before {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0.02) 100%);
}

.theme-dark .wechat-login-btn {
    background: rgba(99, 209, 127, 0.15);
    border-color: rgba(99, 209, 127, 0.55);
    color: #dff9e6;
}

.theme-dark .nav-tabs,
.theme-dark .content-section,
.theme-dark .gallery-section {
    background-color: #171a1f;
}

.theme-dark .nav-tabs {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.12);
}

.theme-dark .tab-item,
.theme-dark .tab-search {
    color: #a8afb8;
}

.theme-dark .tab-item.active {
    color: #63d17f;
}

.theme-dark .section-title,
.theme-dark .subsection-title,
.theme-dark .top10-title,
.theme-dark .recent-history-title,
.theme-dark .archive-count,
.theme-dark .empty-text {
    color: #e9edf2;
}

.theme-dark .section-desc,
.theme-dark .section-arrow,
.theme-dark .top10-desc,
.theme-dark .recent-history-time,
.theme-dark .recent-history-meta,
.theme-dark .archive-label,
.theme-dark .empty-desc {
    color: #9aa2ad;
}

.theme-dark .top10-card,
.theme-dark .recent-history-item,
.theme-dark .history-empty-card,
.theme-dark .music-placeholder {
    background: #20242b;
}

.theme-dark .history-empty-title {
    color: #d6dce4;
}

.theme-dark .recent-history-cover,
.theme-dark .gallery-item {
    background-color: #262b33;
}

.theme-dark .section-header,
.theme-dark .subsection-header {
    border-color: #252a31;
}

.theme-dark .side-drawer {
    background: #16191f;
}

.theme-dark .drawer-header {
    border-bottom-color: #2a3038;
}

.theme-dark .drawer-close,
.theme-dark .drawer-name,
.theme-dark .drawer-item-label {
    color: #eef3f7;
}

.theme-dark .drawer-subtitle,
.theme-dark .drawer-section-title,
.theme-dark .drawer-item-arrow {
    color: #9aa3ad;
}

.theme-dark .drawer-item:active {
    background: #232933;
}

.theme-dark .drawer-tools {
    background: #1f242c;
}

.theme-dark .drawer-tool-item {
    background: #252b34;
}

.theme-dark .drawer-tool-label {
    color: #b8c0ca;
}
