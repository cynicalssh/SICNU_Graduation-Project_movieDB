.page {
  min-height: 100vh;
  background: #f5f5f5;
}

.filter-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  background: #ffffff;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.location-wrapper {
  display: flex;
  align-items: center;
  margin-right: 20rpx;
  padding: 0;
  flex-shrink: 0;
  max-width: 240rpx;
}

.location-icon-wrapper {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 8rpx;
  position: relative;
}

.location-icon-outline {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #FFC107;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
  position: relative;
}

.location-icon-outline::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) rotate(45deg);
  width: 8rpx;
  height: 8rpx;
  background: #FFC107;
  border-radius: 50%;
}

.location-text {
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.search-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
  max-width: 480rpx;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #f5f5f5;
  border-radius: 50rpx;
  min-height: 64rpx;
  box-sizing: border-box;
}

.search-placeholder {
  font-size: 28rpx;
  color: #999;
  flex: 1;
}

.search-icon-wrapper {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
}

.search-icon-outline {
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid #999;
  border-radius: 50%;
  position: relative;
}

.search-icon-outline::after {
  content: '';
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  width: 10rpx;
  height: 2rpx;
  background: #999;
  transform: rotate(45deg);
  border-radius: 2rpx;
}

.content-wrapper {
  min-height: calc(100vh - 200rpx);
  background: linear-gradient(180deg, #f8f9ff 0%, #f5f5f5 100%);
  padding-bottom: 20rpx;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid rgba(102, 126, 234, 0.1);
  border-top-color: #667eea;
  border-right-color: #764ba2;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(102, 126, 234, 0.2);
}

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  color: #999;
  font-weight: 500;
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  min-height: calc(100vh - 200rpx);
}

.empty-icon-wrapper {
  margin-bottom: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-icon-bg {
  width: 240rpx;
  height: 240rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 30rpx rgba(102, 126, 234, 0.3);
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 8rpx 30rpx rgba(102, 126, 234, 0.3);
  }
  50% {
    transform: scale(1.05);
    box-shadow: 0 12rpx 40rpx rgba(102, 126, 234, 0.4);
  }
}

.empty-icon {
  font-size: 120rpx;
  filter: brightness(1.2);
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
}

.cinema-list {
  height: calc(100vh - 200rpx);
  padding: 24rpx 20rpx;
}

.cinema-item {
  display: flex;
  align-items: flex-start;
  padding: 32rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #ffffff 0%, #fafbff 100%);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.cinema-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100%;
  background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
}

.cinema-item:active {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.12);
}

.cinema-left {
  margin-right: 24rpx;
  display: flex;
  align-items: flex-start;
}

.cinema-icon-wrapper {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.cinema-icon {
  font-size: 48rpx;
  filter: brightness(1.2);
}

.cinema-info {
  flex: 1;
  min-width: 0;
}

.cinema-name-wrapper {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.cinema-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-right: 12rpx;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cinema-badge {
  padding: 4rpx 12rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%);
  color: #fff;
  font-size: 20rpx;
  border-radius: 20rpx;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 107, 0.3);
}

.cinema-address-wrapper {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.address-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
  opacity: 0.7;
}

.cinema-address {
  font-size: 26rpx;
  color: #666;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cinema-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
  font-size: 22rpx;
  color: #667eea;
  background-color: rgba(102, 126, 234, 0.1);
  border-radius: 20rpx;
  font-weight: 500;
}

.tag-gradient {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.15) 0%, rgba(118, 75, 162, 0.15) 100%);
  color: #764ba2;
}

.cinema-distance {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.distance-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
  opacity: 0.7;
}

.distance-text {
  font-size: 24rpx;
  color: #999;
}

.cinema-price-wrapper {
  display: flex;
  align-items: center;
  margin-left: 20rpx;
  padding-left: 20rpx;
  border-left: 2rpx solid #f0f0f0;
}

.cinema-price {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.price-symbol {
  font-size: 24rpx;
  color: #ff6b6b;
  margin-right: 2rpx;
  font-weight: 600;
}

.price-value {
  font-size: 40rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  line-height: 1;
}

.price-unit {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 暗黑模式 */
.theme-dark.page {
  background: #0f1216;
}

.theme-dark .filter-bar {
  background: #171b22;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.35);
}

.theme-dark .location-text {
  color: #e3e9ef;
}

.theme-dark .search-input-wrapper {
  background: #262c35;
}

.theme-dark .search-placeholder {
  color: #9da7b5;
}

.theme-dark .search-icon-outline {
  border-color: #9da7b5;
}

.theme-dark .search-icon-outline::after {
  background: #9da7b5;
}

.theme-dark .content-wrapper {
  background: #0f1216;
}

.theme-dark .empty-icon-bg,
.theme-dark .cinema-icon-wrapper,
.theme-dark .cinema-item::before {
  background: linear-gradient(135deg, #2e3440 0%, #262c35 100%);
}

.theme-dark .empty-text {
  color: #d7dde5;
}

.theme-dark .empty-hint,
.theme-dark .distance-text,
.theme-dark .distance-icon,
.theme-dark .cinema-address,
.theme-dark .price-unit {
  color: #9aa3af;
}

.theme-dark .cinema-item {
  background: linear-gradient(135deg, #171b22 0%, #1e242c 100%);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.28);
}

.theme-dark .cinema-name {
  color: #ebeff5;
}

.theme-dark .cinema-price-wrapper {
  border-left-color: #2a3038;
}

.theme-dark .tag {
  background-color: rgba(88, 113, 156, 0.2);
  color: #afc1df;
}

.theme-dark .tag-gradient {
  background: linear-gradient(135deg, rgba(88, 113, 156, 0.2) 0%, rgba(106, 88, 153, 0.2) 100%);
  color: #c2b9e3;
}
