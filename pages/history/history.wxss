@import '../../comm/style/tab.wxss';
@import '../../component/nullTip/nullTip.wxss';

.history-page {
    min-height: 100vh;
    background: linear-gradient(180deg, #f3f8f5 0%, #edf2ef 100%);
    padding-bottom: 40rpx;
}

.history-hero {
    padding: 30rpx 30rpx 20rpx;
}

.history-title {
    font-size: 42rpx;
    color: #1d2b24;
    font-weight: 700;
}

.history-subtitle {
    margin-top: 10rpx;
    font-size: 24rpx;
    color: #6d7d75;
}

.tab-header {
    position: sticky;
    top: 0;
    width: 100%;
    height: 88rpx;
    background: rgba(255, 255, 255, 0.95);
    border-bottom: 1rpx solid #e8eee9;
    backdrop-filter: blur(12rpx);
    z-index: 20;
}

.tab-header-item {
    font-size: 28rpx;
    color: #6a7a72;
}

.tab-header-active {
    color: #2f8f59;
    font-weight: 600;
    border-bottom: 5rpx solid #47a86c;
}

.tab-content {
    margin-top: 12rpx;
}

.tab-content-item {
    box-sizing: border-box;
    padding: 20rpx 24rpx;
}

.history-film-date,
.history-person-date {
    box-sizing: border-box;
    width: 320rpx;
    padding: 10rpx 20rpx;
    margin: 0 auto 22rpx;
    font-size: 26rpx;
    text-align: center;
    color: #6f8077;
    border-radius: 999rpx;
    background: #e8f1eb;
}

.history-film-time {
    margin-bottom: 12rpx;
    color: #9fb2a7;
    font-size: 24rpx;
    text-align: right;
}

.history-film-item {
    margin-bottom: 30rpx;
    border-radius: 22rpx;
    background: #ffffff;
    box-shadow: 0 8rpx 24rpx rgba(44, 72, 56, 0.08);
    padding: 20rpx;
}

.history-film-intro {
    display: flex;
}

.history-film-cover {
    width: 220rpx;
    height: 306rpx;
    border-radius: 14rpx;
    box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.16);
    background: #e8ece9;
}

.history-film-info {
    flex: 1;
    margin-left: 22rpx;
    min-width: 0;
}

.history-film-txt {
    margin-bottom: 10rpx;
    color: #5e7168;
    font-size: 24rpx;
    line-height: 1.5;
}

.history-film-title {
    font-size: 34rpx;
    color: #21342a;
    font-weight: 600;
}

.history-person-item {
    box-sizing: border-box;
    padding: 24rpx;
    margin-bottom: 24rpx;
    background: #ffffff;
    border: 1rpx solid #e8ede9;
    border-radius: 20rpx;
    box-shadow: 0 6rpx 20rpx rgba(33, 47, 38, 0.08);
}

.history-person-intro {
    display: flex;
}

.history-person-info {
    flex: 1;
    margin-left: 20rpx;
    min-width: 0;
}

.history-person-time {
    margin-bottom: 12rpx;
    font-size: 24rpx;
    text-align: right;
    color: #9fb1a7;
}

.history-person-cover {
    width: 190rpx;
    height: 190rpx;
    border-radius: 50%;
    box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.15);
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    flex-shrink: 0;
}

.history-person-txt {
    margin-bottom: 10rpx;
    color: #5f7169;
    font-size: 24rpx;
    line-height: 1.45;
}

.history-person-name {
    font-size: 34rpx;
    color: #25382e;
    font-weight: 600;
}

.theme-dark.history-page {
    background: #0f1216;
}

.theme-dark .history-title {
    color: #ebf1f8;
}

.theme-dark .history-subtitle {
    color: #9ba6b2;
}

.theme-dark .tab-header {
    background: rgba(23, 27, 34, 0.95);
    border-bottom-color: #2e3540;
}

.theme-dark .tab-header-item {
    color: #a6b0bc;
}

.theme-dark .tab-header-active {
    color: #65d091;
    border-bottom-color: #65d091;
}

.theme-dark .history-film-date,
.theme-dark .history-person-date {
    background: #27312a;
    color: #9eb2a5;
}

.theme-dark .history-film-time,
.theme-dark .history-person-time {
    color: #7f8b98;
}

.theme-dark .history-film-item,
.theme-dark .history-person-item {
    background: #171b22;
    border-color: #2b323c;
    box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.28);
}

.theme-dark .history-film-cover {
    background: #262d36;
}

.theme-dark .history-film-txt,
.theme-dark .history-person-txt {
    color: #a8b3bf;
}

.theme-dark .history-film-title,
.theme-dark .history-person-name {
    color: #e8eef6;
}
