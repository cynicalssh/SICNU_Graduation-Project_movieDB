.pd-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #eef2f8 0%, #f7f9fc 55%, #f4f6fb 100%);
}

.pd-loading-shell {
  padding: 28rpx;
}

.pd-loading-hero,
.pd-loading-card {
  border-radius: 30rpx;
  background: #e9edf4;
}

.pd-loading-hero {
  height: 540rpx;
}

.pd-loading-card {
  margin-top: 24rpx;
  height: 240rpx;
}

.shimmer {
  position: relative;
  overflow: hidden;
}

.shimmer::after {
  content: '';
  position: absolute;
  left: -160rpx;
  top: 0;
  width: 160rpx;
  height: 100%;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0));
  animation: shimmerMove 1.2s infinite;
}

@keyframes shimmerMove {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(1060rpx);
  }
}

.pd-error-wrap {
  margin: 220rpx 40rpx 0;
  padding: 46rpx 40rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 16rpx 50rpx rgba(18, 38, 63, 0.1);
  text-align: center;
}

.pd-error-title {
  color: #18273f;
  font-size: 36rpx;
  font-weight: 700;
}

.pd-error-text {
  margin-top: 20rpx;
  color: #62708b;
  font-size: 28rpx;
  line-height: 1.6;
}

.pd-error-btn {
  margin: 30rpx auto 0;
  width: 240rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: linear-gradient(135deg, #1fb66e, #0a9f6b);
  border-radius: 40rpx;
  color: #ffffff;
  font-size: 28rpx;
}

.pd-hero {
  position: relative;
  height: 620rpx;
  overflow: hidden;
}

.pd-hero-bg {
  width: 100%;
  height: 100%;
  transform: scale(1.08);
  filter: blur(18rpx);
}

.pd-hero-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(7, 18, 36, 0.35), rgba(7, 18, 36, 0.75));
}

.pd-hero-content {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  padding: 0 36rpx;
  color: #f8fbff;
}

.pd-avatar {
  width: 220rpx;
  height: 220rpx;
  border-radius: 999rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 20rpx 56rpx rgba(0, 0, 0, 0.3);
}

.pd-name-cn {
  margin-top: 22rpx;
  font-size: 44rpx;
  font-weight: 700;
  text-align: center;
}

.pd-name-en {
  margin-top: 8rpx;
  color: rgba(245, 250, 255, 0.92);
  font-size: 28rpx;
}

.pd-meta {
  margin-top: 16rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  color: rgba(250, 253, 255, 0.95);
  font-size: 24rpx;
}

.pd-action-row {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pd-favorite,
.pd-hero-link {
  min-width: 180rpx;
  height: 66rpx;
  line-height: 66rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 27rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.pd-favorite {
  margin-right: 18rpx;
  color: #eef6ff;
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  background: rgba(255, 255, 255, 0.08);
}

.pd-favorite-active {
  color: #1f9e6d;
  background: #ffffff;
  border-color: #ffffff;
}

.pd-hero-link {
  color: #eef6ff;
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  background: rgba(255, 255, 255, 0.08);
}

.pd-body {
  margin-top: -28rpx;
  border-top-left-radius: 30rpx;
  border-top-right-radius: 30rpx;
  background: #f7f9fc;
  padding: 20rpx 24rpx 40rpx;
}

.pd-stat-grid {
  display: flex;
  align-items: stretch;
  margin-bottom: 22rpx;
}

.pd-stat-item {
  flex: 1;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 14rpx;
  box-shadow: 0 10rpx 24rpx rgba(12, 31, 58, 0.05);
  text-align: center;
}

.pd-stat-item + .pd-stat-item {
  margin-left: 14rpx;
}

.pd-stat-label {
  color: #71809e;
  font-size: 24rpx;
}

.pd-stat-value {
  margin-top: 10rpx;
  color: #1b2b47;
  font-size: 30rpx;
  font-weight: 700;
}

.pd-section {
  margin-top: 18rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(12, 31, 58, 0.05);
  padding: 24rpx;
}

.pd-section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pd-section-title {
  color: #1d2f4d;
  font-size: 32rpx;
  font-weight: 700;
}

.pd-section-sub {
  color: #8a98b1;
  font-size: 24rpx;
}

.pd-intro-text {
  margin-top: 16rpx;
  color: #3f4f69;
  line-height: 1.76;
  font-size: 27rpx;
}

.pd-intro-toggle {
  margin-top: 16rpx;
  display: inline-block;
  color: #11a06b;
  font-size: 25rpx;
}

.pd-link-list {
  margin-top: 14rpx;
  font-size: 0;
}

.pd-link-chip {
  display: inline-block;
  margin-right: 14rpx;
  margin-bottom: 14rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  color: #2f5a4a;
  font-size: 24rpx;
  background: linear-gradient(135deg, #dff8ea, #d0f2ff);
}

.pd-work-scroll {
  margin-top: 18rpx;
  width: 100%;
  white-space: nowrap;
}

.pd-work-row {
  display: inline-flex;
  align-items: flex-start;
}

.pd-work-card {
  width: 228rpx;
  margin-right: 18rpx;
  border-radius: 18rpx;
}

.pd-work-cover {
  width: 228rpx;
  height: 320rpx;
  border-radius: 14rpx;
  background: #eef2f8;
}

.pd-work-cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a98b1;
  font-size: 22rpx;
}

.pd-work-title {
  margin-top: 12rpx;
  color: #1f2f4d;
  font-size: 26rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.pd-work-meta {
  margin-top: 6rpx;
  color: #75839f;
  font-size: 22rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.pd-work-rate {
  margin-top: 6rpx;
  color: #ef8f13;
  font-size: 22rpx;
}

.pd-album-section {
  padding: 0;
  overflow: hidden;
  background: #3f432c;
}

.pd-album-title {
  color: #f3f4ec;
}

.pd-album-sub {
  color: rgba(240, 240, 230, 0.65);
  padding-right: 24rpx;
}

.pd-album-section .pd-section-title-row {
  padding: 24rpx 24rpx 18rpx;
}

.pd-photo-scroll {
  width: 100%;
  white-space: nowrap;
}

.pd-photo-strip {
  display: inline-flex;
  align-items: center;
  padding: 0 10rpx 18rpx 10rpx;
}

.pd-photo-card {
  width: 344rpx;
  height: 236rpx;
  margin: 0 6rpx;
  border-radius: 0;
  overflow: hidden;
  background: #2d311f;
}

.pd-photo-item {
  width: 100%;
  height: 100%;
  border-radius: 0;
  background: #545a3f;
}

.pd-empty-tip {
  margin-top: 14rpx;
  color: #8a98b1;
  font-size: 25rpx;
}

.pd-album-empty {
  color: rgba(240, 240, 230, 0.65);
  padding: 0 24rpx 24rpx;
}
