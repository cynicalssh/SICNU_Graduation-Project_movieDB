@import "../../comm/style/animation.wxss";
@import "../../component/message/message.wxss";

.container {
    min-height: 100vh;
    background: linear-gradient(180deg, #f3f8f5 0%, #edf2ef 100%);
}

.fd-loading-shell {
    min-height: 62vh;
    padding: 140rpx 48rpx 0;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
}

.fd-loading-orb {
    width: 132rpx;
    height: 132rpx;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, rgba(124, 218, 158, 0.98), rgba(52, 166, 101, 0.95) 62%, rgba(32, 128, 75, 0.9) 100%);
    box-shadow: 0 16rpx 42rpx rgba(44, 132, 84, 0.25);
    opacity: 0.14;
    filter: blur(2rpx);
}

.fd-loading-ring {
    width: 84rpx;
    height: 84rpx;
    margin-top: -108rpx;
    border-radius: 50%;
    border: 6rpx solid rgba(64, 164, 103, 0.22);
    border-top-color: #44aa71;
    border-right-color: rgba(68, 170, 113, 0.72);
    animation: fdRotate 1s linear infinite;
}

.fd-loading-title {
    margin-top: 30rpx;
    font-size: 31rpx;
    font-weight: 600;
    color: #335348;
    letter-spacing: 0.4rpx;
}

.fd-loading-subtitle {
    margin-top: 10rpx;
    font-size: 24rpx;
    color: #7a8f84;
}

.fd-loading-bar {
    width: 420rpx;
    max-width: 100%;
    height: 14rpx;
    border-radius: 999rpx;
    background: rgba(66, 154, 105, 0.14);
    overflow: hidden;
    margin-top: 24rpx;
    position: relative;
}

.fd-loading-bar-shimmer {
    width: 46%;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, rgba(71, 168, 108, 0.18) 0%, rgba(71, 168, 108, 0.9) 55%, rgba(71, 168, 108, 0.18) 100%);
    animation: fdBarMove 1.35s ease-in-out infinite;
}

@keyframes fdRotate {
    0% {
        transform: rotate(0deg);
    }
    100% {
        transform: rotate(360deg);
    }
}

@keyframes fdBarMove {
    0% {
        transform: translateX(-100%);
    }
    100% {
        transform: translateX(260%);
    }
}

.fd-hd {
    position: relative;
    width: 100%;
    min-height: 660rpx;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    overflow: hidden;
    padding: 74rpx 24rpx 170rpx;
    box-sizing: border-box;
}

.fd-hd:before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    background: rgba(17, 29, 23, 0.58);
}

.fd-hd-bg {
    position: absolute;
    z-index: -2;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    filter: blur(34rpx);
    transform: scale(1.24);
}

.fd-cover {
    z-index: 2;
    width: 292rpx;
    height: 410rpx;
    border-radius: 14rpx;
    box-shadow: 0 26rpx 70rpx rgba(0, 0, 0, 0.44);
    background: rgba(255, 255, 255, 0.18);
    flex-shrink: 0;
}

.fd-intro {
    z-index: 2;
    width: 360rpx;
    max-height: 410rpx;
    margin-left: 34rpx;
    color: #1f2a24;
    overflow-y: scroll;
    -webkit-overflow-scrolling: touch;
}

.fd-title {
    margin-bottom: 26rpx;
    font-size: 42rpx;
    line-height: 1.28;
    font-weight: 700;
    color: #18221d;
}

.fd-intro-txt {
    margin-bottom: 14rpx;
    color: #2a3a32;
    line-height: 1.55;
    font-size: 25rpx;
}

.fd-actions {
    box-sizing: border-box;
    position: absolute;
    z-index: 9;
    bottom: 34rpx;
    left: 24rpx;
    right: 24rpx;
    display: flex;
    align-items: center;
    gap: 14rpx;
}

.fd-action-btn {
    flex: 1;
    height: 66rpx;
    line-height: 66rpx;
    border-radius: 999rpx;
    border: 1rpx solid rgba(255, 255, 255, 0.75);
    text-align: center;
    color: #fff;
    font-size: 27rpx;
    background: rgba(0, 0, 0, 0.2);
}

.fd-action-active {
    border-color: #73d69a;
    color: #73d69a;
    background: rgba(25, 92, 56, 0.22);
}

.fd-buy-ticket {
    flex: 1.3;
    height: 66rpx;
    line-height: 66rpx;
    border-radius: 999rpx;
    background: linear-gradient(135deg, #4eb278 0%, #3f9d66 100%);
    color: #fff;
    text-align: center;
    font-weight: 600;
    font-size: 28rpx;
    box-shadow: 0 10rpx 20rpx rgba(30, 88, 58, 0.35);
}

.fd-data {
    display: flex;
    min-height: 152rpx;
    justify-content: space-around;
    align-items: center;
    border-bottom: 1rpx solid #e5ece8;
    background: #ffffff;
}

.fd-data-item {
    width: 33.33%;
    text-align: center;
    border-left: 1rpx solid #edf2ef;
}

.fd-data-item:first-child {
    border-left: none;
}

.fd-data-num {
    font-size: 40rpx;
    font-weight: 700;
    color: #2f8f59;
}

.fd-data-title {
    margin-top: 6rpx;
    color: #809088;
    font-size: 24rpx;
}

.fd-bd {
    padding: 0 24rpx 40rpx;
}

.fd-bd-title {
    padding-left: 16rpx;
    margin-top: 34rpx;
    margin-bottom: 18rpx;
    font-size: 31rpx;
    font-weight: 700;
    color: #2a3e33;
    border-left: 8rpx solid #47a86c;
}

.fd-bd-intro {
    text-align: justify;
    line-height: 1.8;
    color: #596b62;
    font-size: 26rpx;
    background: #ffffff;
    border-radius: 18rpx;
    padding: 20rpx 22rpx;
    box-shadow: 0 8rpx 24rpx rgba(45, 66, 53, 0.07);
}

.fd-bd-tag {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
}

.fd-bd-tag-item {
    padding: 8rpx 18rpx;
    border: 1rpx solid #d5e7dc;
    border-radius: 999rpx;
    color: #3e915d;
    background: #ecf8f1;
    font-size: 24rpx;
}

.fd-bd-person {
    display: flex;
    width: 100%;
    padding: 10rpx 0;
    overflow-x: scroll;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
}

.fd-bd-person-item {
    flex-shrink: 0;
    margin-right: 18rpx;
    width: 178rpx;
    text-align: center;
    background: #ffffff;
    border-radius: 16rpx;
    padding: 14rpx;
    box-shadow: 0 8rpx 18rpx rgba(32, 52, 41, 0.08);
}

.fd-bd-person-avatar {
    width: 150rpx;
    height: 198rpx;
    border-radius: 12rpx;
    object-fit: cover;
    background: #e5ebe7;
    margin-bottom: 10rpx;
}

.fd-bd-person-name {
    color: #2a3b32;
    font-size: 27rpx;
    font-weight: 600;
    margin-bottom: 4rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.fd-bd-person-role {
    color: #7f8f87;
    font-size: 22rpx;
}

.fd-reviews {
    margin-top: 16rpx;
}

.fd-review-item {
    padding: 24rpx;
    border-radius: 18rpx;
    background: #ffffff;
    box-shadow: 0 8rpx 22rpx rgba(30, 44, 36, 0.07);
    margin-bottom: 16rpx;
}

.fd-review-header {
    display: flex;
    align-items: center;
    margin-bottom: 16rpx;
}

.fd-review-avatar {
    width: 74rpx;
    height: 74rpx;
    border-radius: 50%;
    margin-right: 16rpx;
    background-color: #e8efeb;
}

.fd-review-avatar-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #53ba7f 0%, #3e9c66 100%);
    color: #fff;
    font-size: 30rpx;
    font-weight: 600;
}

.fd-review-info {
    flex: 1;
}

.fd-review-author {
    font-size: 30rpx;
    font-weight: 600;
    color: #2a3d32;
}

.fd-review-date {
    margin-top: 4rpx;
    font-size: 22rpx;
    color: #8c9993;
}

.fd-review-rating {
    display: flex;
    align-items: center;
    padding: 8rpx 14rpx;
    background: #e8f6ee;
    border-radius: 999rpx;
}

.fd-review-rating-text {
    font-size: 24rpx;
    color: #2f8f59;
    font-weight: 600;
    margin-right: 4rpx;
}

.fd-review-rating-star {
    font-size: 20rpx;
}

.fd-review-content {
    font-size: 27rpx;
    line-height: 1.75;
    color: #596b62;
}

.fd-review-load-more,
.fd-discussion-load-more {
    text-align: center;
    padding: 24rpx 0 8rpx;
    color: #7f8d86;
    font-size: 26rpx;
}

.fd-review-empty,
.fd-discussion-empty {
    text-align: center;
    padding: 58rpx 0;
    color: #90a09a;
    font-size: 27rpx;
}

.fd-discussions {
    margin-top: 14rpx;
}

.fd-discussion-item {
    background: #ffffff;
    border-radius: 18rpx;
    margin-bottom: 18rpx;
    padding: 24rpx;
    box-shadow: 0 8rpx 22rpx rgba(30, 44, 36, 0.07);
}

.fd-discussion-header {
    margin-bottom: 14rpx;
}

.fd-discussion-title {
    font-size: 32rpx;
    font-weight: 700;
    color: #2a3c32;
    margin-bottom: 10rpx;
    line-height: 1.45;
}

.fd-discussion-meta {
    display: flex;
    align-items: center;
    font-size: 22rpx;
    color: #8c9a93;
}

.fd-discussion-author {
    margin-right: 20rpx;
}

.fd-discussion-content {
    font-size: 27rpx;
    line-height: 1.75;
    color: #5a6c63;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    text-overflow: ellipsis;
}

.fd-discussion-content.expanded {
    display: block;
    -webkit-line-clamp: unset;
    overflow: visible;
}

.fd-discussion-expand-btn {
    margin-top: 12rpx;
    text-align: right;
}

.fd-discussion-expand-btn text {
    display: inline-block;
    font-size: 24rpx;
    color: #3d9d66;
    padding: 4rpx 12rpx;
    border-radius: 999rpx;
    background: #eaf6ef;
}

.fd-discussion-footer {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    column-gap: 16rpx;
    padding-top: 16rpx;
    border-top: 1rpx solid #ecf1ee;
    margin-top: 14rpx;
}

.fd-discussion-replies {
    display: inline-flex;
    align-items: center;
    height: 36rpx;
    font-size: 24rpx;
    line-height: 1.2;
    color: #809089;
    white-space: nowrap;
    flex-shrink: 0;
}

.fd-discussion-replies.active {
    color: #2f9059;
    font-weight: 600;
}

.fd-discussion-score {
    display: inline-flex;
    align-items: center;
    height: 36rpx;
    font-size: 24rpx;
    line-height: 1.2;
    color: #2f9059;
    white-space: nowrap;
    flex-shrink: 0;
}

.fd-discussion-translate {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 36rpx;
    padding: 0 10rpx;
    border-radius: 999rpx;
    font-size: 24rpx;
    line-height: 1.2;
    color: #2f9059;
    white-space: nowrap;
    flex-shrink: 0;
}

.fd-discussion-translate.is-loading {
    color: #2f9059;
    background: rgba(63, 157, 102, 0.1);
}

.fd-inline-loader {
    display: inline-flex;
    align-items: center;
    column-gap: 6rpx;
    margin-right: 8rpx;
}

.fd-inline-loader-sm {
    column-gap: 5rpx;
    margin-right: 7rpx;
}

.fd-inline-loader-dot {
    width: 8rpx;
    height: 8rpx;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.26;
    animation: fdTranslateDot 1s ease-in-out infinite;
}

.fd-inline-loader-sm .fd-inline-loader-dot {
    width: 7rpx;
    height: 7rpx;
}

.fd-inline-loader-dot:nth-child(2) {
    animation-delay: 0.14s;
}

.fd-inline-loader-dot:nth-child(3) {
    animation-delay: 0.28s;
}

@keyframes fdTranslateDot {
    0%, 80%, 100% {
        transform: translateY(0);
        opacity: 0.22;
    }
    40% {
        transform: translateY(-4rpx);
        opacity: 1;
    }
}

.fd-discussion-replies-list {
    margin-top: 18rpx;
    padding-top: 16rpx;
    border-top: 1rpx solid #ebf0ec;
}

.fd-reply-loading,
.fd-reply-empty {
    padding: 20rpx 0;
    text-align: center;
    color: #8b9a93;
    font-size: 24rpx;
}

.fd-reply-item {
    padding: 14rpx 0;
    border-bottom: 1rpx solid #f2f5f3;
}

.fd-reply-item:last-child {
    border-bottom: none;
}

.fd-reply-header {
    display: flex;
    align-items: center;
    margin-bottom: 8rpx;
}

.fd-reply-author {
    font-size: 24rpx;
    color: #2f9059;
    font-weight: 600;
    margin-right: 16rpx;
}

.fd-reply-date {
    font-size: 22rpx;
    color: #99a69f;
}

.fd-reply-content {
    font-size: 25rpx;
    color: #4f6158;
    line-height: 1.6;
}

.fd-reply-footer {
    display: flex;
    align-items: center;
    column-gap: 18rpx;
    margin-top: 8rpx;
}

.fd-reply-score {
    font-size: 22rpx;
    color: #8c9a94;
}

.fd-reply-translate {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 34rpx;
    padding: 0 10rpx;
    border-radius: 999rpx;
    font-size: 23rpx;
    color: #2f9059;
}

.fd-reply-translate.is-loading {
    color: #2f9059;
    background: rgba(63, 157, 102, 0.1);
}

.fd-reply-translation-error {
    margin-top: 8rpx;
    font-size: 22rpx;
    color: #c75656;
}

.theme-dark.container {
    background: #0f1216;
}

.theme-dark .fd-loading-orb {
    background: radial-gradient(circle at 30% 30%, rgba(119, 210, 151, 0.84), rgba(51, 143, 92, 0.84) 62%, rgba(30, 89, 60, 0.82) 100%);
    box-shadow: 0 18rpx 48rpx rgba(17, 45, 32, 0.4);
}

.theme-dark .fd-loading-ring {
    border-color: rgba(118, 205, 150, 0.2);
    border-top-color: #72d39f;
    border-right-color: rgba(114, 211, 159, 0.66);
}

.theme-dark .fd-loading-title {
    color: #dfe9e3;
}

.theme-dark .fd-loading-subtitle {
    color: #9bab9f;
}

.theme-dark .fd-loading-bar {
    background: rgba(110, 194, 146, 0.16);
}

.theme-dark .fd-loading-bar-shimmer {
    background: linear-gradient(90deg, rgba(114, 211, 159, 0.14) 0%, rgba(114, 211, 159, 0.85) 55%, rgba(114, 211, 159, 0.14) 100%);
}

.theme-dark .fd-hd:before {
    background: rgba(6, 10, 14, 0.66);
}

.theme-dark .fd-intro {
    color: #f3f8f5;
}

.theme-dark .fd-title {
    color: #ffffff;
}

.theme-dark .fd-intro-txt {
    color: rgba(243, 248, 245, 0.9);
}

.theme-dark .fd-action-btn {
    border-color: rgba(235, 244, 255, 0.7);
}

.theme-dark .fd-action-active {
    border-color: #66cf92;
    color: #66cf92;
    background: rgba(23, 66, 45, 0.38);
}

.theme-dark .fd-data,
.theme-dark .fd-bd-intro,
.theme-dark .fd-bd-person-item,
.theme-dark .fd-review-item,
.theme-dark .fd-discussion-item {
    background: #171b22;
    box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.28);
}

.theme-dark .fd-data {
    border-bottom-color: #2a313b;
}

.theme-dark .fd-data-item {
    border-left-color: #2a313b;
}

.theme-dark .fd-data-num,
.theme-dark .fd-review-rating-text,
.theme-dark .fd-discussion-replies.active,
.theme-dark .fd-discussion-score,
.theme-dark .fd-reply-author {
    color: #66cf92;
}

.theme-dark .fd-data-title,
.theme-dark .fd-review-date,
.theme-dark .fd-discussion-meta,
.theme-dark .fd-discussion-replies,
.theme-dark .fd-reply-date,
.theme-dark .fd-reply-score,
.theme-dark .fd-review-load-more,
.theme-dark .fd-discussion-load-more,
.theme-dark .fd-review-empty,
.theme-dark .fd-discussion-empty,
.theme-dark .fd-reply-loading,
.theme-dark .fd-reply-empty {
    color: #8f9aa6;
}

.theme-dark .fd-bd-title,
.theme-dark .fd-bd-person-name,
.theme-dark .fd-review-author,
.theme-dark .fd-discussion-title {
    color: #e8eef6;
}

.theme-dark .fd-bd-intro,
.theme-dark .fd-review-content,
.theme-dark .fd-discussion-content,
.theme-dark .fd-reply-content,
.theme-dark .fd-bd-person-role,
.theme-dark .fd-bd-tag-item {
    color: #a8b3bf;
}

.theme-dark .fd-bd-tag-item {
    border-color: #2d3e35;
    background: #1c3025;
}

.theme-dark .fd-discussion-expand-btn text {
    background: #23352b;
    color: #7cd6a3;
}

.theme-dark .fd-discussion-translate {
    color: #7cd6a3;
}

.theme-dark .fd-discussion-translate.is-loading {
    color: #7cd6a3;
    background: rgba(124, 214, 163, 0.14);
}

.theme-dark .fd-reply-translate {
    color: #7cd6a3;
}

.theme-dark .fd-reply-translate.is-loading {
    color: #7cd6a3;
    background: rgba(124, 214, 163, 0.14);
}

.theme-dark .fd-reply-translation-error {
    color: #ff8f8f;
}

.theme-dark .fd-discussion-footer,
.theme-dark .fd-discussion-replies-list,
.theme-dark .fd-reply-item {
    border-color: #2a313a;
}
