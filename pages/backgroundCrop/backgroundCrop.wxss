.crop-page {
  position: fixed;
  inset: 0;
  background: #080b10;
  color: #fff;
  display: flex;
  flex-direction: column;
}

.crop-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 26rpx 18rpx;
}

.crop-top-btn {
  min-width: 132rpx;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.24);
}

.crop-top-btn-primary {
  background: linear-gradient(135deg, #45c86c 0%, #35a75a 100%);
  border-color: rgba(167, 246, 186, 0.42);
  color: #fff;
}

.crop-title {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.28);
}

.crop-stage {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0 24rpx;
}

.crop-frame {
  position: relative;
  border-radius: 22rpx;
  overflow: hidden;
  box-shadow: 0 0 0 2000rpx rgba(0, 0, 0, 0.56);
  border: 2rpx solid rgba(255, 255, 255, 0.75);
  background: rgba(255, 255, 255, 0.06);
}

.crop-image {
  position: absolute;
}

.crop-grid {
  position: absolute;
  inset: 0;
  pointer-events: none;
  border: 2rpx solid rgba(255, 255, 255, 0.85);
}

.crop-grid::before,
.crop-grid::after {
  content: '';
  position: absolute;
  left: 33.3333%;
  top: 0;
  width: 2rpx;
  height: 100%;
  background: rgba(255, 255, 255, 0.32);
}

.crop-grid::after {
  left: 66.6667%;
}

.crop-footer {
  padding: 16rpx 32rpx calc(env(safe-area-inset-bottom) + 36rpx);
}

.crop-slider-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.86);
  margin-bottom: 10rpx;
}

.crop-slider {
  margin: 0;
}

.crop-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 0;
  height: 0;
  opacity: 0;
  pointer-events: none;
}
