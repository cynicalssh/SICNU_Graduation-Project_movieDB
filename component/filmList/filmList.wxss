@import "../../comm/style/animation.wxss";

.film {
    box-sizing: border-box;
    width: 750rpx;
    padding: 20rpx 22rpx 26rpx;
    background: linear-gradient(180deg, #f6fbf8 0%, #f1f5f4 100%);
}

.film-item {
    width: 100%;
    margin-bottom: 26rpx;
    border-radius: 24rpx;
    background: #ffffff;
    box-shadow: 0 8rpx 28rpx rgba(47, 91, 67, 0.08);
    overflow: hidden;
    animation: fadeIn 0.45s;
    display: flex;
    flex-direction: row;
    padding: 22rpx;
    position: relative;
}

.film-item::before {
    content: '';
    position: absolute;
    top: 16rpx;
    bottom: 16rpx;
    left: 0;
    width: 7rpx;
    border-radius: 0 7rpx 7rpx 0;
    background: linear-gradient(180deg, #67cb8f 0%, #42a86c 100%);
}

.film-poster {
    width: 196rpx;
    height: 276rpx;
    border-radius: 16rpx;
    overflow: hidden;
    flex-shrink: 0;
    box-shadow: 0 6rpx 18rpx rgba(20, 32, 24, 0.2);
    background: #e6ece8;
}

.film-poster-img {
    width: 100%;
    height: 100%;
}

.film-info {
    flex: 1;
    margin-left: 24rpx;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
}

.film-title-row {
    margin-bottom: 16rpx;
}

.film-title {
    font-size: 35rpx;
    font-weight: 700;
    color: #1d2b24;
    line-height: 1.42;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    margin-bottom: 8rpx;
}

.film-short-review {
    font-size: 24rpx;
    color: #5f6f67;
    line-height: 1.6;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-top: 2rpx;
}

.film-short-review .quote {
    color: #a0aea7;
}

.film-genres {
    display: flex;
    flex-wrap: wrap;
    margin-bottom: 14rpx;
    gap: 10rpx;
}

.film-genre-tag {
    display: inline-block;
    padding: 5rpx 14rpx;
    background: linear-gradient(135deg, #4fb379 0%, #3f9d66 100%);
    color: #ffffff;
    font-size: 21rpx;
    border-radius: 999rpx;
    line-height: 1.35;
}

.film-rating-section {
    display: flex;
    flex-direction: column;
    margin-bottom: 16rpx;
}

.film-rating-main {
    display: flex;
    align-items: center;
    margin-bottom: 6rpx;
}

.film-rating-score {
    font-size: 44rpx;
    font-weight: 700;
    color: #42a86c;
    margin-right: 14rpx;
    line-height: 1;
}

.film-rating-count {
    font-size: 22rpx;
    color: #8b9992;
    line-height: 1;
}

.film-wish-section {
    display: flex;
    align-items: center;
}

.film-wish-count {
    font-size: 41rpx;
    font-weight: 700;
    color: #3d9f67;
    line-height: 1;
}

.film-wish-placeholder {
    font-size: 30rpx;
    color: #8d9893;
    font-weight: normal;
}

.film-stars {
    display: flex;
    align-items: center;
    gap: 2rpx;
}

.star-wrapper {
    position: relative;
    width: 20rpx;
    height: 20rpx;
    margin-right: 2rpx;
}

.star-bg {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
}

.star-fill {
    position: absolute;
    width: 0%;
    height: 100%;
    top: 0;
    left: 0;
    overflow: hidden;
    transition: width 0.3s ease;
}

.star-icon {
    font-size: 20rpx;
    line-height: 1;
    display: block;
    width: 20rpx;
    height: 20rpx;
}

.star-icon.star-filled {
    color: #ffcc54;
}

.star-icon.star-empty {
    color: #dde4df;
}

.film-cast {
    font-size: 25rpx;
    color: #607068;
    line-height: 1.6;
    margin-bottom: 12rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
}

.film-cast-label {
    color: #8d9b95;
}

.film-cast-names {
    color: #32433b;
}

.film-meta {
    font-size: 24rpx;
    color: #607068;
    margin-bottom: 12rpx;
    line-height: 1.6;
}

.film-meta-item {
    display: inline;
}

.film-meta-label {
    color: #8d9b95;
}

.film-meta-value {
    color: #61726a;
}

.film-stats {
    font-size: 23rpx;
    color: #607068;
    margin-bottom: 12rpx;
    display: flex;
    align-items: center;
}

.film-stat-item {
    display: inline-flex;
    align-items: baseline;
}

.film-stat-value {
    color: #42a86c;
    font-weight: 600;
    margin-right: 4rpx;
}

.film-stat-label {
    color: #8c9892;
}

.film-release {
    font-size: 25rpx;
    color: #2f8e59;
    margin-bottom: 20rpx;
    font-weight: 600;
}

.film-release-date {
    color: #2f8e59;
}

.film-actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 20rpx;
    margin-top: auto;
}

.film-buy-btn {
    width: 146rpx;
    height: 62rpx;
    line-height: 62rpx;
    background: linear-gradient(135deg, #4eb278 0%, #3e9e66 100%);
    color: #fff;
    border: none;
    border-radius: 999rpx;
    font-size: 27rpx;
    font-weight: 600;
    padding: 0;
    margin: 0;
    box-shadow: 0 8rpx 18rpx rgba(63, 157, 102, 0.28);
}

.film-buy-btn::after {
    border: none;
}

.film-action-icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 84rpx;
    height: 84rpx;
    border-radius: 50%;
    background: #eef5f1;
    transition: all 0.3s ease;
}

.film-action-icon .icon {
    font-size: 34rpx;
    line-height: 1;
    margin-bottom: 4rpx;
    color: #6f8077;
    transition: all 0.3s ease;
}

.film-action-icon .label {
    font-size: 20rpx;
    color: #6f8077;
    transition: all 0.3s ease;
}

.film-action-icon.active {
    background: #dcf4e6;
    box-shadow: 0 4rpx 12rpx rgba(65, 160, 105, 0.2);
}

.film-action-icon.active .icon,
.film-action-icon.active .label {
    color: #2f8e59;
}

.film-action-icon.active .icon {
    transform: scale(1.1);
}

.film-action-icon:active {
    transform: scale(0.95);
    background: #d7ece1;
}

.loading-tip {
    width: 100%;
    min-height: 86rpx;
    line-height: 1.5;
    text-align: center;
    color: #8a9991;
    font-size: 25rpx;
    padding: 14rpx 0;
}

.loading-tip.loading-more::before {
    content: '';
    display: inline-block;
    width: 18rpx;
    height: 18rpx;
    margin-right: 12rpx;
    border-radius: 50%;
    border: 3rpx solid rgba(64, 165, 108, 0.2);
    border-top-color: #43aa6e;
    animation: tipSpin 0.9s linear infinite;
    vertical-align: middle;
}

.loading-tip.loading-end::before {
    content: none;
}

.film-loading-shell {
    width: 100%;
    box-sizing: border-box;
    padding: 26rpx 22rpx 24rpx;
    border-radius: 22rpx;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(243, 248, 245, 0.96) 100%);
    border: 1rpx solid rgba(117, 150, 129, 0.12);
    box-shadow: 0 10rpx 24rpx rgba(40, 81, 59, 0.08);
}

.film-loading-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 22rpx;
}

.film-loading-spinner {
    width: 78rpx;
    height: 78rpx;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* Source style adapted from SpinKit (MIT): https://github.com/tobiasahlin/SpinKit */
.sk-chase {
    width: 52rpx;
    height: 52rpx;
    position: relative;
    animation: sk-chase 2.3s infinite linear both;
}

.sk-chase-dot {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    animation: sk-chase-dot 2s infinite ease-in-out both;
}

.sk-chase-dot::before {
    content: '';
    display: block;
    width: 12rpx;
    height: 12rpx;
    border-radius: 50%;
    background: linear-gradient(135deg, #57ca89 0%, #3fa36b 100%);
    animation: sk-chase-dot-before 2s infinite ease-in-out both;
    box-shadow: 0 0 12rpx rgba(65, 168, 108, 0.35);
}

.sk-chase-dot:nth-child(1) {
    animation-delay: -1.1s;
}
.sk-chase-dot:nth-child(2) {
    animation-delay: -1s;
}
.sk-chase-dot:nth-child(3) {
    animation-delay: -0.9s;
}
.sk-chase-dot:nth-child(4) {
    animation-delay: -0.8s;
}
.sk-chase-dot:nth-child(5) {
    animation-delay: -0.7s;
}
.sk-chase-dot:nth-child(6) {
    animation-delay: -0.6s;
}
.sk-chase-dot:nth-child(1)::before {
    animation-delay: -1.1s;
}
.sk-chase-dot:nth-child(2)::before {
    animation-delay: -1s;
}
.sk-chase-dot:nth-child(3)::before {
    animation-delay: -0.9s;
}
.sk-chase-dot:nth-child(4)::before {
    animation-delay: -0.8s;
}
.sk-chase-dot:nth-child(5)::before {
    animation-delay: -0.7s;
}
.sk-chase-dot:nth-child(6)::before {
    animation-delay: -0.6s;
}

.film-loading-title {
    margin-top: 10rpx;
    font-size: 30rpx;
    color: #2a3e35;
    font-weight: 600;
}

.film-loading-subtitle {
    margin-top: 6rpx;
    font-size: 22rpx;
    color: #8c9b94;
}

.film-loading-skeleton {
    display: flex;
    flex-direction: column;
    gap: 14rpx;
}

.skeleton-card {
    display: flex;
    gap: 14rpx;
    border-radius: 16rpx;
    padding: 16rpx;
    background: rgba(255, 255, 255, 0.72);
}

.skeleton-poster {
    width: 112rpx;
    height: 152rpx;
    border-radius: 12rpx;
    flex-shrink: 0;
}

.skeleton-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12rpx;
}

.skeleton-line {
    height: 18rpx;
    border-radius: 9rpx;
}

.skeleton-line.line-1 {
    width: 72%;
}

.skeleton-line.line-2 {
    width: 52%;
}

.skeleton-line.line-3 {
    width: 88%;
}

.skeleton-line.line-4 {
    width: 46%;
}

.skeleton-shimmer {
    background: linear-gradient(100deg, rgba(205, 217, 209, 0.25) 20%, rgba(174, 188, 180, 0.45) 40%, rgba(205, 217, 209, 0.25) 60%);
    background-size: 220% 100%;
    animation: skeletonShimmer 1.4s ease-in-out infinite;
}

@keyframes sk-chase {
    100% {
        transform: rotate(360deg);
    }
}

@keyframes sk-chase-dot {
    80%, 100% {
        transform: rotate(360deg);
    }
}

@keyframes sk-chase-dot-before {
    50% {
        transform: scale(0.42);
        opacity: 0.45;
    }
    100%, 0% {
        transform: scale(1);
        opacity: 1;
    }
}

@keyframes skeletonShimmer {
    0% {
        background-position: 100% 0;
    }
    100% {
        background-position: -100% 0;
    }
}

@keyframes tipSpin {
    to {
        transform: rotate(360deg);
    }
}

.theme-dark .film {
    background: #0f1216;
}

.theme-dark .film-item {
    background: #171b22;
    box-shadow: 0 10rpx 26rpx rgba(0, 0, 0, 0.28);
}

.theme-dark .film-item::before {
    background: linear-gradient(180deg, #5fc487 0%, #3f9d66 100%);
}

.theme-dark .film-poster {
    background: #262d36;
}

.theme-dark .film-title {
    color: #eaf0f6;
}

.theme-dark .film-short-review,
.theme-dark .film-meta-value,
.theme-dark .film-cast,
.theme-dark .film-stats {
    color: #a6b1bc;
}

.theme-dark .film-short-review .quote,
.theme-dark .film-meta-label,
.theme-dark .film-cast-label,
.theme-dark .film-rating-count,
.theme-dark .film-stat-label {
    color: #7f8a96;
}

.theme-dark .film-cast-names {
    color: #dbe3ec;
}

.theme-dark .star-icon.star-empty {
    color: #495360;
}

.theme-dark .film-action-icon {
    background: #252b34;
}

.theme-dark .film-action-icon .icon,
.theme-dark .film-action-icon .label {
    color: #9ca6b2;
}

.theme-dark .film-action-icon.active {
    background: #1f3d2f;
}

.theme-dark .film-action-icon.active .icon,
.theme-dark .film-action-icon.active .label {
    color: #67cf95;
}

.theme-dark .film-buy-btn {
    box-shadow: 0 8rpx 16rpx rgba(24, 58, 39, 0.45);
}

.theme-dark .loading-tip {
    color: #8f9aa6;
}

.theme-dark .film-loading-shell {
    background: linear-gradient(180deg, rgba(27, 33, 40, 0.96) 0%, rgba(22, 28, 35, 0.96) 100%);
    border-color: rgba(121, 139, 155, 0.22);
    box-shadow: 0 14rpx 26rpx rgba(0, 0, 0, 0.26);
}

.theme-dark .film-loading-title {
    color: #e3ecf4;
}

.theme-dark .film-loading-subtitle {
    color: #8a97a5;
}

.theme-dark .skeleton-card {
    background: rgba(35, 42, 50, 0.68);
}

.theme-dark .skeleton-shimmer {
    background: linear-gradient(100deg, rgba(90, 104, 116, 0.18) 20%, rgba(112, 128, 142, 0.32) 40%, rgba(90, 104, 116, 0.18) 60%);
}

.theme-dark .loading-tip.loading-more::before {
    border-color: rgba(129, 149, 168, 0.24);
    border-top-color: #68cd97;
}
