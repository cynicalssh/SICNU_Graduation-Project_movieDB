.null-tip {
    position: relative;
    margin: 80rpx 20rpx 28rpx;
    padding: 180rpx 30rpx 0;
    text-align: center;
    color: #7c8c84;
    font-size: 28rpx;
    line-height: 1.6;
}

.null-tip::before {
    content: '🎬';
    position: absolute;
    top: 12rpx;
    left: 50%;
    transform: translateX(-50%);
    width: 128rpx;
    height: 128rpx;
    border-radius: 50%;
    background: linear-gradient(145deg, #e8f4ec 0%, #dff0e6 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 64rpx;
    box-shadow: 0 10rpx 26rpx rgba(53, 81, 65, 0.13);
}

.null-action {
    margin: 0 auto 40rpx;
    width: 220rpx;
    height: 78rpx;
    line-height: 78rpx;
    text-align: center;
    border-radius: 999rpx;
    border: 1rpx solid #48ab6d;
    color: #2f8f59;
    background: #ffffff;
    box-shadow: 0 4rpx 14rpx rgba(44, 78, 59, 0.08);
}

.null-action:active {
    background: #47a86c;
    color: #fff;
}

.theme-dark .null-tip {
    color: #94a0ac;
}

.theme-dark .null-tip::before {
    background: linear-gradient(145deg, #233029 0%, #1f2a24 100%);
    box-shadow: none;
}

.theme-dark .null-action {
    background: #171b22;
    border-color: #5ecb8c;
    color: #73d79a;
    box-shadow: none;
}

.theme-dark .null-action:active {
    background: #25553d;
    color: #d9ffe9;
}
